#!/bin/sh
set -eu

export DEBIAN_FRONTEND=noninteractive

if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR This installer helper must run as root."
    exit 1
fi

if [ "$#" -eq 0 ]; then
    echo "ERROR No packages were selected."
    exit 1
fi

for package in "$@"; do
    case "$package" in
        *[!A-Za-z0-9+._:-]*|"")
            echo "ERROR Refusing unsafe package name: $package"
            exit 1
            ;;
    esac
done

echo "STEP Updating package lists"
apt-get update -y

for package in "$@"; do
    echo "STEP Checking $package"
    if ! apt-cache show "$package" >/dev/null 2>&1; then
        echo "SKIP $package is not available in the configured repositories"
        continue
    fi

    echo "STEP Installing $package"
    if apt-get install -y "$package"; then
        echo "DONE $package"
    else
        echo "ERROR $package"
    fi
done

echo "FINISHED"
