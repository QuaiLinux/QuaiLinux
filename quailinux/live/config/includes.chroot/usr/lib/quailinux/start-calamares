#!/bin/sh
set -u

log=/tmp/quailinux-installer.log
if ! touch "$log" 2>/dev/null || ! chmod 0666 "$log" 2>/dev/null; then
    log="/tmp/quailinux-installer.$(id -u).log"
    : > "$log" 2>/dev/null || log=/dev/null
    chmod 0666 "$log" 2>/dev/null || true
fi

{
    echo "=== QuaiLinux Calamares starter ==="
    date
    echo "user=$(id -un) uid=$(id -u)"
    echo "display=${DISPLAY-}"
    echo "wayland=${WAYLAND_DISPLAY-}"
    echo "xdg_runtime_dir=${XDG_RUNTIME_DIR-}"
} >> "$log" 2>&1

if [ "$(id -u)" -ne 0 ]; then
    exec quailinux-installer "$@"
fi

if [ -e /etc/fstab ] && [ ! -e /etc/fstab.orig.quailinux-calamares ]; then
    mv /etc/fstab /etc/fstab.orig.quailinux-calamares
fi

export QT_AUTO_SCREEN_SCALE_FACTOR=1
export CALAMARES_DISPLAY_NAME="QuaiLinux Installer"

if [ ! -x /usr/bin/calamares ]; then
    echo "calamares binary not found" >> "$log"
    exit 127
fi

if [ ! -r /etc/calamares/settings.conf ]; then
    echo "missing /etc/calamares/settings.conf" >> "$log"
    if command -v kdialog >/dev/null 2>&1; then
        kdialog --error "The QuaiLinux installer configuration is missing: /etc/calamares/settings.conf"
    fi
    exit 78
fi

exec /usr/bin/calamares -d -c /etc/calamares/settings.conf
