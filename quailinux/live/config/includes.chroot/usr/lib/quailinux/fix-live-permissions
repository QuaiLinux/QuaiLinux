#!/bin/sh
set -eu

for helper in /usr/bin/sudo /usr/bin/pkexec; do
    if [ -f "$helper" ]; then
        chown root:root "$helper"
        chmod 4755 "$helper"
    fi
done

if [ -d /etc/sudoers.d ]; then
    chown root:root /etc/sudoers.d
    chmod 0755 /etc/sudoers.d
fi

if [ -f /etc/sudoers.d/quailinux-live ]; then
    chown root:root /etc/sudoers.d/quailinux-live
    chmod 0440 /etc/sudoers.d/quailinux-live
fi

rm -f /tmp/quailinux-installer.log
install -m 0666 /dev/null /tmp/quailinux-installer.log
