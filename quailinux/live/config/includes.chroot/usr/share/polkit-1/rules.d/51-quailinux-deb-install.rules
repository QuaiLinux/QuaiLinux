polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.policykit.exec" &&
        action.lookup("program") === "/usr/lib/quailinux/install-deb-helper" &&
        subject.local &&
        subject.active &&
        subject.isInGroup("sudo")) {
        return polkit.Result.YES;
    }
});
