polkit.addRule(function(action, subject) {
    if (action.id === "org.kde.kpmcore.externalcommand.init" &&
        (subject.user === "root" || subject.user === "quai")) {
        return polkit.Result.YES;
    }

    if (subject.local &&
        subject.active &&
        subject.user === "quai" &&
        subject.isInGroup("sudo")) {
        return polkit.Result.YES;
    }
});
