#!/bin/sh
set -u

log=/tmp/quailinux-installer.log
if ! touch "$log" 2>/dev/null || ! chmod 0666 "$log" 2>/dev/null; then
    log="/tmp/quailinux-installer.$(id -u).log"
    : > "$log" 2>/dev/null || log=/dev/null
    chmod 0666 "$log" 2>/dev/null || true
fi

{
    echo "=== QuaiLinux installer launcher ==="
    date
    echo "user=$(id -un) uid=$(id -u)"
    echo "display=${DISPLAY-}"
    echo "wayland=${WAYLAND_DISPLAY-}"
    echo "xdg_runtime_dir=${XDG_RUNTIME_DIR-}"
} >> "$log" 2>&1

export QT_AUTO_SCREEN_SCALE_FACTOR=1
export QT_QPA_PLATFORMTHEME=kde
export XDG_CURRENT_DESKTOP=KDE

if command -v xhost >/dev/null 2>&1; then
    xhost +si:localuser:root >/dev/null 2>&1 || true
fi

run_installer() {
    if [ "$(id -u)" -eq 0 ]; then
        exec /usr/lib/quailinux/start-calamares
    fi

    if command -v sudo >/dev/null 2>&1 && [ -u /usr/bin/sudo ]; then
        exec sudo env \
            DISPLAY="${DISPLAY-}" \
            WAYLAND_DISPLAY="${WAYLAND_DISPLAY-}" \
            XAUTHORITY="${XAUTHORITY-}" \
            XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR-}" \
            DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS-}" \
            QT_AUTO_SCREEN_SCALE_FACTOR="${QT_AUTO_SCREEN_SCALE_FACTOR-1}" \
            QT_QPA_PLATFORMTHEME="${QT_QPA_PLATFORMTHEME-kde}" \
            XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP-KDE}" \
            /usr/lib/quailinux/start-calamares
    fi

    if command -v pkexec >/dev/null 2>&1 && [ -u /usr/bin/pkexec ]; then
        exec pkexec env \
            DISPLAY="${DISPLAY-}" \
            WAYLAND_DISPLAY="${WAYLAND_DISPLAY-}" \
            XAUTHORITY="${XAUTHORITY-}" \
            XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR-}" \
            DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS-}" \
            QT_AUTO_SCREEN_SCALE_FACTOR="${QT_AUTO_SCREEN_SCALE_FACTOR-1}" \
            QT_QPA_PLATFORMTHEME="${QT_QPA_PLATFORMTHEME-kde}" \
            XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP-KDE}" \
            /usr/lib/quailinux/start-calamares
    fi

    echo "neither sudo nor pkexec is usable" >&2
    return 127
}

run_installer >> "$log" 2>&1
status=$?

if command -v xhost >/dev/null 2>&1; then
    xhost -si:localuser:root >/dev/null 2>&1 || true
fi

if [ "$status" -ne 0 ] && command -v kdialog >/dev/null 2>&1; then
    kdialog --error "The QuaiLinux installer did not start. A log was written to $log."
fi

exit "$status"
