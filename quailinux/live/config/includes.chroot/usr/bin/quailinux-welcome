class CategoryCard(QFrame):
    def __init__(self, key, data, on_open):
        super().__init__()
        self.key = key
        self._on_open = on_open
        self.setObjectName("CategoryCard")
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.setFixedSize(220, 220)
        self.setSizePolicy(QSizePolicy.Policy.Fixed, QSizePolicy.Policy.Fixed)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(20, 20, 20, 20)
        layout.setSpacing(14)
        layout.setAlignment(Qt.AlignmentFlag.AlignCenter)

        icon = QLabel()
        pix = QPixmap(str(ICON_DIR / data["icon"]))
        icon.setPixmap(pix.scaled(88, 88, Qt.AspectRatioMode.KeepAspectRatio, Qt.TransformationMode.SmoothTransformation))
        icon.setFixedSize(96, 96)
        icon.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(icon, alignment=Qt.AlignmentFlag.AlignCenter)

        title = QLabel(data["title"])
        title.setObjectName("CardTitle")
        title.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(title)

        button = QPushButton("Open")
        button.setObjectName("CardButton")
        button.clicked.connect(lambda: self._on_open(key))
        layout.addWidget(button)

    def mouseDoubleClickEvent(self, event):
        self._on_open(self.key)
        super().mouseDoubleClickEvent(event)


class PackagePage(QWidget):
    def __init__(self, key, data, go_home, begin_install):
        super().__init__()
        self.key = key
        self.data = data
        self.checks = []

        outer = QVBoxLayout(self)
        outer.setContentsMargins(22, 22, 22, 22)
        outer.setSpacing(14)

        top = QHBoxLayout()
        back = QPushButton("Back")
        back.clicked.connect(go_home)
        top.addWidget(back)
        title = QLabel(data["title"])
        title.setObjectName("PageTitle")
        top.addWidget(title, 1)
        outer.addLayout(top)

        listbox = QListWidget()
        listbox.setObjectName("PackageList")
        for package, label in data["packages"]:
            item = QListWidgetItem()
            checkbox = QCheckBox(f"{label}  ({package})")
            checkbox.setChecked(True)
            self.checks.append((checkbox, package))
            item.setSizeHint(checkbox.sizeHint())
            listbox.addItem(item)
            listbox.setItemWidget(item, checkbox)
        outer.addWidget(listbox, 1)

        buttons = QHBoxLayout()
        select_all = QPushButton("Select all")
        select_all.clicked.connect(lambda: self.set_all(True))
        select_none = QPushButton("Select none")
        select_none.clicked.connect(lambda: self.set_all(False))
        install = QPushButton("Install")
        install.setObjectName("PrimaryButton")
        install.clicked.connect(lambda: begin_install(self.data["title"], self.selected_packages()))
        buttons.addWidget(select_all)
        buttons.addWidget(select_none)
        buttons.addStretch()
        buttons.addWidget(install)
        outer.addLayout(buttons)

    def set_all(self, value):
        for checkbox, _package in self.checks:
            checkbox.setChecked(value)

    def selected_packages(self):
        return [package for checkbox, package in self.checks if checkbox.isChecked()]


class ProgressPage(QWidget):
    def __init__(self, go_home):
        super().__init__()
        self.process = None
        self.total = 0
        self.completed = 0

        outer = QVBoxLayout(self)
        outer.setContentsMargins(22, 22, 22, 22)
        outer.setSpacing(14)

        top = QHBoxLayout()
        self.back = QPushButton("Back")
        self.back.clicked.connect(go_home)
        top.addWidget(self.back)
        self.title = QLabel("Installing")
        self.title.setObjectName("PageTitle")
        top.addWidget(self.title, 1)
        outer.addLayout(top)

        self.status = QLabel("Preparing...")
        self.status.setObjectName("InstallStatus")
        self.status.setWordWrap(True)
        outer.addWidget(self.status)

        self.progress = QProgressBar()
        self.progress.setRange(0, 100)
        self.progress.setValue(0)
        outer.addWidget(self.progress)

        self.log = QListWidget()
        self.log.setObjectName("InstallLog")
        outer.addWidget(self.log, 1)

        bottom = QHBoxLayout()
        self.close_button = QPushButton("Done")
        self.close_button.setEnabled(False)
        self.close_button.clicked.connect(go_home)
        bottom.addStretch()
        bottom.addWidget(self.close_button)
        outer.addLayout(bottom)

    def start(self, title, packages):
        if not packages:
            QMessageBox.information(self, "Nothing selected", "Choose at least one package first.")
            return False

        self.total = len(packages)
        self.completed = 0
        self.progress.setValue(0)
        self.status.setText("Starting package installation...")
        self.title.setText(title)
        self.log.clear()
        self.back.setEnabled(False)
        self.close_button.setEnabled(False)

        self.process = QProcess(self)
        self.process.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
        self.process.readyReadStandardOutput.connect(self.read_output)
        self.process.finished.connect(self.finished)
        self.process.start("pkexec", [INSTALL_HELPER, *packages])
        if not self.process.waitForStarted(3000):
            self.status.setText("Could not start the installer helper.")
            self.log.addItem("Could not start pkexec.")
            self.back.setEnabled(True)
            self.close_button.setEnabled(True)
        return True

    def read_output(self):
        if not self.process:
            return
        text = bytes(self.process.readAllStandardOutput()).decode("utf-8", "replace")
        for raw_line in text.splitlines():
            line = raw_line.strip()
            if not line:
                continue
            self.handle_line(line)

    def handle_line(self, line):
        if line.startswith("STEP "):
            self.status.setText(line[5:])
            self.log.addItem(line[5:])
            return
        if line.startswith("DONE "):
            self.completed += 1
            self.progress.setValue(min(100, int((self.completed / max(1, self.total)) * 100)))
            self.log.addItem("Installed: " + line[5:])
            return
        if line.startswith("SKIP "):
            self.completed += 1
            self.progress.setValue(min(100, int((self.completed / max(1, self.total)) * 100)))
            self.log.addItem("Skipped: " + line[5:])
            return
        if line.startswith("ERROR "):
            self.completed += 1
            self.progress.setValue(min(100, int((self.completed / max(1, self.total)) * 100)))
            self.log.addItem("Failed: " + line[6:])
            return
        if line.startswith("FINISHED"):
            self.progress.setValue(100)
            self.status.setText("Finished installing selected packages.")
            return
        self.log.addItem(line)

    def finished(self, exit_code, _status):
        self.back.setEnabled(True)
        self.close_button.setEnabled(True)
        if exit_code == 0:
            self.progress.setValue(100)
            self.status.setText("Finished installing selected packages.")
        else:
            self.status.setText("Package installation stopped before finishing.")


class Welcome(QDialog):
    def __init__(self, autostart=False):
        super().__init__()
        self.autostart = autostart
        self.setWindowTitle("QuaiLinux Welcome")
        self.setMinimumSize(920, 720)
        self.setWindowIcon(QIcon("/usr/share/quailinux/artwork/icon.png"))

        root = QVBoxLayout(self)
        root.setContentsMargins(24, 24, 24, 24)
        root.setSpacing(18)

        header = QHBoxLayout()
        title = QLabel("Welcome to QuaiLinux")
        title.setObjectName("HeroTitle")
        header.addWidget(title, 1)
        skip = QPushButton("Do not show again")
        skip.clicked.connect(self.mark_done_and_close)
        header.addWidget(skip)
        root.addLayout(header)

        self.stack = QStackedWidget()
        root.addWidget(self.stack, 1)

        home = QWidget()
        grid = QGridLayout(home)
        grid.setSpacing(18)
        for index, key in enumerate(CATEGORIES):
            card = CategoryCard(key, CATEGORIES[key], self.open_category)
            grid.addWidget(card, index // 3, index % 3)
        for column in range(3):
            grid.setColumnStretch(column, 1)
        for row in range(2):
            grid.setRowStretch(row, 1)
        self.stack.addWidget(home)

        self.pages = {}
        for key, data in CATEGORIES.items():
            page = PackagePage(key, data, self.go_home, self.begin_install)
            self.pages[key] = page
            self.stack.addWidget(page)

        self.progress_page = ProgressPage(self.go_home)
        self.stack.addWidget(self.progress_page)

        self.setStyleSheet("""
            QDialog {
                background: palette(window);
            }
            QLabel#HeroTitle {
                font-size: 30px;
                font-weight: 700;
            }
            QLabel#CardTitle {
                font-size: 22px;
                font-weight: 700;
            }
            QLabel#PageTitle {
                font-size: 24px;
                font-weight: 700;
            }
            QLabel#InstallStatus {
                font-size: 14px;
            }
            QFrame#CategoryCard {
                border: 1px solid palette(midlight);
                border-radius: 8px;
                background: palette(base);
            }
            QFrame#CategoryCard:hover {
                border: 1px solid palette(highlight);
            }
            QListWidget#PackageList,
            QListWidget#InstallLog {
                border: 1px solid palette(midlight);
                border-radius: 8px;
                background: palette(base);
                padding: 8px;
            }
            QPushButton {
                min-height: 34px;
                padding-left: 14px;
                padding-right: 14px;
            }
            QPushButton#CardButton,
            QPushButton#PrimaryButton {
                font-weight: 700;
            }
        """)

    def open_category(self, key):
        self.stack.setCurrentWidget(self.pages[key])

    def begin_install(self, title, packages):
        if self.progress_page.start(title, packages):
            self.stack.setCurrentWidget(self.progress_page)

    def go_home(self):
        self.stack.setCurrentIndex(0)

    def mark_done_and_close(self):
        DONE_FILE.parent.mkdir(parents=True, exist_ok=True)
        DONE_FILE.write_text("done\n")
        self.accept()

    def closeEvent(self, event):
        if self.autostart:
            DONE_FILE.parent.mkdir(parents=True, exist_ok=True)
            DONE_FILE.write_text("done\n")
        super().closeEvent(event)


def main():
    autostart = "--autostart" in sys.argv
    if autostart and DONE_FILE.exists():
        return 0
    app = QApplication(sys.argv)
    dialog = Welcome(autostart=autostart)
    dialog.show()
    return app.exec()


if __name__ == "__main__":
    raise SystemExit(main())
