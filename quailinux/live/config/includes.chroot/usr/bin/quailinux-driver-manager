BASE_PACKAGES = ["linux-firmware", "firmware-linux", "firmware-linux-free", "firmware-linux-nonfree"]


def run_text(command):
    try:
        return subprocess.run(command, text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=8).stdout
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return ""


def package_installed(package):
    try:
        result = subprocess.run(
            ["dpkg-query", "-W", "-f=${Status}", package],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=4,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return False
    return result.returncode == 0 and result.stdout.strip() == "install ok installed"


def read_text(path):
    try:
        return Path(path).read_text(errors="replace")
    except OSError:
        return ""


def hardware_text():
    parts = [
        run_text(["lspci", "-nnk"]),
        run_text(["lsusb"]),
        read_text("/sys/class/dmi/id/sys_vendor"),
        read_text("/sys/class/dmi/id/product_name"),
        read_text("/sys/class/dmi/id/product_version"),
    ]
    return "\n".join(parts)


def matching_device_blocks(text, patterns):
    sections = []
    current = []
    for line in text.splitlines():
        starts_device = (
            re.match(r"^[0-9a-fA-F:.]+\\s", line) or
            line.startswith("Bus ")
        )
        if starts_device and current:
            sections.append("\n".join(current))
            current = []
        current.append(line)
    if current:
        sections.append("\n".join(current))

    blocks = []
    for block in sections:
        if any(re.search(pattern, block, re.IGNORECASE) for pattern in patterns):
            cleaned = []
            for line in block.splitlines():
                line = line.strip()
                if line:
                    cleaned.append(line)
            if cleaned:
                blocks.append(cleaned)
    return blocks


def kernel_drivers(blocks):
    drivers = []
    for block in blocks:
        for line in block:
            match = re.search(r"Kernel driver in use:\s*(.+)", line, re.IGNORECASE)
            if match:
                driver = match.group(1).strip()
                if driver not in drivers:
                    drivers.append(driver)
    return drivers


def scan_matches():
    text = hardware_text()
    lower = text.lower()
    matches = []
    seen = set()
    for rule in RULES:
        if any(re.search(pattern, lower, re.IGNORECASE) for pattern in rule["patterns"]):
            blocks = matching_device_blocks(text, rule["patterns"])
            packages = []
            for package in rule["packages"]:
                if package not in seen:
                    packages.append(package)
                    seen.add(package)
            matches.append({
                **rule,
                "packages": packages,
                "devices": blocks[:3],
                "drivers": kernel_drivers(blocks),
            })
    return matches


def package_state(packages):
    installed = []
    missing = []
    for package in packages:
        if package_installed(package):
            installed.append(package)
        else:
            missing.append(package)
    return installed, missing


def status_for_packages(packages):
    installed, missing = package_state(packages)
    if installed and not missing:
        return "Installed", "installed"
    if installed and missing:
        return "Partial", "partial"
    return "Recommended", "recommended"


class DriverCard(QFrame):
    def __init__(self, match):
        super().__init__()
        self.match = match
        self.item = None
        self.list_widget = None
        self.setObjectName("DriverCard")
        layout = QVBoxLayout(self)
        layout.setContentsMargins(14, 12, 14, 12)
        layout.setSpacing(6)

        status_text, status_kind = status_for_packages(match["packages"])
        top = QHBoxLayout()
        top.setSpacing(10)
        title = QLabel(match["name"])
        title.setObjectName("CardTitle")
        top.addWidget(title, 1)

        badge = QLabel(status_text)
        badge.setObjectName("StatusBadge")
        badge.setProperty("kind", status_kind)
        badge.setAlignment(Qt.AlignmentFlag.AlignCenter)
        top.addWidget(badge)
        layout.addLayout(top)

        reason = QLabel(match["reason"])
        reason.setObjectName("CardReason")
        reason.setWordWrap(True)
        layout.addWidget(reason)

        packages = QLabel(", ".join(match["packages"]))
        packages.setObjectName("PackageText")
        packages.setWordWrap(True)
        layout.addWidget(packages)

        self.details = QFrame()
        self.details.setObjectName("DetailsPanel")
        details_layout = QVBoxLayout(self.details)
        details_layout.setContentsMargins(10, 10, 10, 10)
        details_layout.setSpacing(6)

        installed, missing = package_state(match["packages"])
        detail_lines = []
        if match["drivers"]:
            detail_lines.append("Current kernel driver: " + ", ".join(match["drivers"]))
        else:
            detail_lines.append("Current kernel driver: not reported")
        if installed:
            detail_lines.append("Already installed: " + ", ".join(installed))
        if missing:
            detail_lines.append("Will install: " + ", ".join(missing))

        if match["devices"]:
            detail_lines.append("")
            detail_lines.append("Detected device:")
            for line in match["devices"][0][:5]:
                detail_lines.append(line)
        else:
            detail_lines.append("Detected device: matched from system hardware data")

        details_text = QLabel("\n".join(detail_lines))
        details_text.setObjectName("DetailsText")
        details_text.setWordWrap(True)
        details_layout.addWidget(details_text)
        self.details.hide()
        layout.addWidget(self.details)

        self.details_button = QPushButton("Details")
        self.details_button.setObjectName("DetailsButton")
        self.details_button.clicked.connect(self.toggle_details)
        layout.addWidget(self.details_button, alignment=Qt.AlignmentFlag.AlignRight)

    def toggle_details(self):
        show = not self.details.isVisible()
        self.details.setVisible(show)
        self.details_button.setText("Hide details" if show else "Details")
        if self.item:
            self.item.setSizeHint(self.sizeHint())
        if self.list_widget:
            self.list_widget.doItemsLayout()


class DriverManager(QMainWindow):
    def __init__(self):
        super().__init__()
        self.process = None
        self.matches = []
        self.setWindowTitle("QuaiLinux Driver Manager")
        self.setWindowIcon(QIcon("preferences-system"))
        self.setMinimumSize(760, 560)

        root = QWidget()
        self.setCentralWidget(root)
        layout = QVBoxLayout(root)
        layout.setContentsMargins(22, 20, 22, 20)
        layout.setSpacing(14)

        header = QHBoxLayout()
        title = QLabel("Driver Manager")
        title.setObjectName("HeroTitle")
        header.addWidget(title, 1)
        self.scan_button = QPushButton("Scan")
        self.scan_button.clicked.connect(self.scan)
        header.addWidget(self.scan_button)
        layout.addLayout(header)

        self.summary = QLabel("Scan your computer for hardware that may need extra drivers or firmware.")
        self.summary.setObjectName("SummaryText")
        self.summary.setWordWrap(True)
        layout.addWidget(self.summary)

        self.list = QListWidget()
        self.list.setObjectName("DriverList")
        layout.addWidget(self.list, 1)

        self.empty_state = QFrame()
        self.empty_state.setObjectName("EmptyState")
        empty_layout = QVBoxLayout(self.empty_state)
        empty_layout.setContentsMargins(28, 28, 28, 28)
        empty_layout.setSpacing(10)
        empty_layout.addStretch()

        empty_title = QLabel("All set")
        empty_title.setObjectName("EmptyTitle")
        empty_title.setAlignment(Qt.AlignmentFlag.AlignCenter)
        empty_layout.addWidget(empty_title)

        empty_message = QLabel("No missing driver setup was detected. Your hardware already looks ready.")
        empty_message.setObjectName("EmptyMessage")
        empty_message.setAlignment(Qt.AlignmentFlag.AlignCenter)
        empty_message.setWordWrap(True)
        empty_layout.addWidget(empty_message)

