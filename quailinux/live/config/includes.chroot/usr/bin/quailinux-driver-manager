        layout.addWidget(self.empty_state, 1)

        self.progress = QProgressBar()
        self.progress.setRange(0, 0)
        self.progress.hide()
        layout.addWidget(self.progress)

        self.log = QListWidget()
        self.log.setObjectName("InstallLog")
        self.log.hide()
        layout.addWidget(self.log, 1)

