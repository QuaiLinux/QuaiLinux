#!/bin/sh
set -eu

printf 'QuaiLinux\n' > /etc/hostname

cat > /etc/quailinux-release <<'EOF'
QuaiLinux live image based on Debian
EOF

cat > /usr/lib/os-release <<'EOF'
PRETTY_NAME="QuaiLinux 0.1"
NAME="QuaiLinux"
VERSION_ID="0.1"
VERSION="0.1 (Trixie)"
VERSION_CODENAME=trixie
ID=quailinux
ID_LIKE=debian
HOME_URL="https://quailinux.local/"
SUPPORT_URL="https://quailinux.local/support"
BUG_REPORT_URL="https://quailinux.local/issues"
EOF

ln -sf ../usr/lib/os-release /etc/os-release

cat > /etc/issue <<'EOF'
QuaiLinux 0.1 \n \l
EOF

cat > /etc/issue.net <<'EOF'
QuaiLinux 0.1
EOF

cat > /etc/motd <<'EOF'
Welcome to QuaiLinux.
EOF

for file in \
    /usr/bin/quailinux-installer \
    /usr/bin/add-calamares-desktop-icon \
    /usr/bin/quailinux-welcome \
    /usr/bin/quailinux-install-deb \
    /usr/bin/neofetch \
    /usr/bin/org.kde.kpmcore.helperinterface \
    /usr/lib/quailinux/start-calamares \
    /usr/lib/quailinux/apply-wallpaper \
    /usr/lib/quailinux/fix-live-permissions \
    /usr/lib/quailinux/clean-live-desktop \
    /usr/lib/aarch64-linux-gnu/libexec/org.kde.kpmcore.helperinterface
do
    [ -f "$file" ] || continue
    chmod +x "$file"
    chown root:root "$file"
done
for dir in /usr /usr/bin /usr/lib /usr/share /root /etc/skel; do
    [ -d "$dir" ] && chown root:root "$dir"
done
[ -d /usr/share/quailinux ] && chown -R root:root /usr/share/quailinux
[ -d /usr/share/backgrounds/quailinux ] && chown -R root:root /usr/share/backgrounds/quailinux
[ -d /usr/share/wallpapers/QuaiLinux ] && chown -R root:root /usr/share/wallpapers/QuaiLinux
[ -d /usr/share/plasma/desktoptheme ] && chown root:root /usr/share/plasma/desktoptheme/*/plasmarc 2>/dev/null || true
[ -d /usr/share/plasma/look-and-feel ] && chown root:root /usr/share/plasma/look-and-feel/*/contents/defaults 2>/dev/null || true
[ -d /usr/share/icons/hicolor/256x256/apps ] && chown root:root /usr/share/icons/hicolor/256x256/apps/quailinux*.png 2>/dev/null || true
[ -f /etc/dbus-1/system.d/org.kde.kpmcore.helperinterface.quailinux.conf ] && chown root:root /etc/dbus-1/system.d/org.kde.kpmcore.helperinterface.quailinux.conf
[ -f /usr/share/dbus-1/system-services/org.kde.kpmcore.helperinterface.service ] && chown root:root /usr/share/dbus-1/system-services/org.kde.kpmcore.helperinterface.service
[ -f /usr/share/polkit-1/rules.d/49-quailinux-live.rules ] && chown root:root /usr/share/polkit-1/rules.d/49-quailinux-live.rules
chown root:root /etc/profile.d/quailinux-live-installer.sh
chown root:root /etc/sudoers.d /etc/sudoers.d/quailinux-live
chmod 0755 /etc/sudoers.d
chmod 0440 /etc/sudoers.d/quailinux-live
[ -f /usr/bin/sudo ] && chown root:root /usr/bin/sudo && chmod 4755 /usr/bin/sudo
[ -f /usr/bin/pkexec ] && chown root:root /usr/bin/pkexec && chmod 4755 /usr/bin/pkexec
[ -d /etc/calamares ] && chown -R root:root /etc/calamares
[ -f /usr/share/applications/quailinux-installer.desktop ] && chown root:root /usr/share/applications/quailinux-installer.desktop
[ -d /root/.config ] && chown -R root:root /root/.config
[ -f /etc/xdg/plasmarc ] && chown root:root /etc/xdg/plasmarc
[ -f /etc/xdg/plasma-org.kde.plasma.desktop-appletsrc ] && chown root:root /etc/xdg/plasma-org.kde.plasma.desktop-appletsrc
[ -d /etc/skel/.config ] && chown -R root:root /etc/skel/.config

mkdir -p /etc/systemd/system/multi-user.target.wants
ln -sf ../quailinux-live-permissions.service /etc/systemd/system/multi-user.target.wants/quailinux-live-permissions.service

rm -f /usr/share/applications/calamares-install-debian.desktop
rm -f /usr/share/applications/calamares.desktop.orig
rm -f /usr/share/applications/calamares.desktop
rm -f /usr/share/applications/install-debian.desktop
rm -f /usr/share/applications/debian-installer.desktop

install -d /etc/xdg/autostart
cat > /etc/xdg/autostart/calamares-desktop-icon.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Add Calamares Desktop Icon
Exec=/usr/lib/quailinux/clean-live-desktop
NoDisplay=true
Hidden=true
X-GNOME-Autostart-enabled=false
EOF
chown root:root /etc/xdg/autostart/calamares-desktop-icon.desktop
chmod 0644 /etc/xdg/autostart/calamares-desktop-icon.desktop

cat > /usr/share/applications/calamares-install-debian.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Install QuaiLinux
GenericName=System Installer
Comment=Install QuaiLinux to this computer
Exec=quailinux-installer
Icon=calamares
Terminal=false
StartupNotify=true
Categories=Qt;KDE;System;
NoDisplay=true
EOF

cat > /usr/share/applications/calamares.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Install QuaiLinux
GenericName=System Installer
Comment=Install QuaiLinux to this computer
Exec=quailinux-installer
Icon=calamares
Terminal=false
StartupNotify=true
Categories=Qt;KDE;System;
NoDisplay=true
EOF

if [ -f /etc/calamares/settings.conf ]; then
    sed -i 's/^branding:.*/branding: quailinux/' /etc/calamares/settings.conf
fi

if [ -f /usr/share/quailinux/artwork/icon.png ]; then
    install -d /usr/share/icons/hicolor/256x256/apps
    install -m 0644 /usr/share/quailinux/artwork/icon.png /usr/share/icons/hicolor/256x256/apps/quailinux.png
fi

if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database /usr/share/applications || true
fi

if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f /usr/share/icons/hicolor || true
fi
