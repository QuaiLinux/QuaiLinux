#!/bin/sh
set -eu

mkdir -p /usr/share/polkit-1/rules.d
cat > /usr/share/polkit-1/rules.d/49-quailinux-live.rules <<'EOF'
polkit.addRule(function(action, subject) {
    if (action.id === "org.kde.kpmcore.externalcommand.init" &&
        (subject.user === "root" || subject.user === "quai")) {
        return polkit.Result.YES;
    }

    if (subject.local &&
        subject.active &&
        subject.user === "quai" &&
        subject.isInGroup("sudo")) {
        return polkit.Result.YES;
    }
});
EOF

mkdir -p /etc/sudoers.d
chown root:root /etc/sudoers.d
chmod 0755 /etc/sudoers.d
cat > /etc/sudoers.d/quailinux-live <<'EOF'
quai ALL=(ALL) NOPASSWD: ALL
quai ALL=(root) NOPASSWD:SETENV: /usr/bin/env *, /usr/lib/quailinux/start-calamares
EOF
chown root:root /etc/sudoers.d/quailinux-live
chmod 0440 /etc/sudoers.d/quailinux-live
